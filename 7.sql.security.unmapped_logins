
/*
===============================================================================
ZABBIX SQL SERVER MONITORING - VERSION 1.0
===============================================================================
Name         : 7.sql.security.unmapped_logins
Purpose      : Count server logins without direct database
               mappings, server role memberships or explicit
               granted server permissions.

ODBC Key     : db.odbc.select[7.sql.security.unmapped_logins,,"Driver={$MSSQL.ODBC.DRIVER};Server={$MSSQL.HOST};Port={$MSSQL.PORT};UID={$MSSQL.USER};PWD={$MSSQL.PASSWORD};Encrypt={$MSSQL.ENCRYPT}"]

Interval     : 24h
History      : 730d
Trends       : 1825d
Type         : Numeric (unsigned)
Compatibility: SQL Server 2012+

AG Handling  : Includes system databases, standalone
               databases and local AG primary replicas.
               Excludes AG secondary databases.

Notes        : Includes SQL logins, Windows logins and groups.
               Excludes sa, internal system logins and
               selected Windows service accounts.
               Checks direct database mappings by SID.
               Includes system databases in mapping checks.
               Excludes logins with server role memberships
               or explicit granted server permissions.
               Does not evaluate inherited Windows group
               permissions or indirect access paths.
               Does not prove that a login is unused.
               Requires sufficient metadata visibility.
               Returns one integer.
===============================================================================
*/

SET NOCOUNT ON;

DECLARE @UnmappedLogins int = 0;
DECLARE @Database sysname;
DECLARE @SQL nvarchar(max);

------------------------------------------------------------
-- Temporary table for mapped database principals
------------------------------------------------------------

CREATE TABLE #MappedLogins
(
    login_sid varbinary(85) NOT NULL
);

CREATE INDEX IX_MappedLogins_SID
ON #MappedLogins (login_sid);

------------------------------------------------------------
-- Find eligible databases
--
-- Includes:
--   * System databases
--   * Standalone databases
--   * Local AG primary databases
--
-- Excludes:
--   * AG secondary databases
--   * Offline databases
--   * Database snapshots
------------------------------------------------------------

DECLARE databases CURSOR LOCAL FAST_FORWARD FOR

SELECT
    d.name
FROM sys.databases AS d
WHERE d.state_desc = N'ONLINE'
  AND d.source_database_id IS NULL
  AND
  (
      d.database_id <= 4

      OR d.replica_id IS NULL

      OR EXISTS
      (
          SELECT 1
          FROM sys.dm_hadr_database_replica_states AS drs
          INNER JOIN sys.dm_hadr_availability_replica_states AS ars
              ON ars.group_id = drs.group_id
             AND ars.replica_id = drs.replica_id
          WHERE drs.database_id = d.database_id
            AND drs.is_local = 1
            AND ars.is_local = 1
            AND ars.role = 1
      )
  );

------------------------------------------------------------
-- Collect database principal SIDs
------------------------------------------------------------

OPEN databases;

FETCH NEXT FROM databases INTO @Database;

WHILE @@FETCH_STATUS = 0
BEGIN

    SET @SQL = N'
        USE ' + QUOTENAME(@Database) + N';

        INSERT INTO #MappedLogins (login_sid)
        SELECT DISTINCT
            dp.sid
        FROM sys.database_principals AS dp
        WHERE dp.type IN (N''S'', N''U'', N''G'')
          AND dp.sid IS NOT NULL
          AND dp.principal_id > 4;
    ';

    EXEC sys.sp_executesql @SQL;

    FETCH NEXT FROM databases INTO @Database;

END;

CLOSE databases;
DEALLOCATE databases;

------------------------------------------------------------
-- Count logins without mappings or server privileges
------------------------------------------------------------

SELECT
    @UnmappedLogins = COUNT(*)
FROM sys.server_principals AS sp
WHERE sp.type IN (N'S', N'U', N'G')

  ----------------------------------------------------------
  -- Exclude system and internal accounts
  ----------------------------------------------------------

  AND sp.name NOT LIKE N'##MS[_]%'
  AND sp.name <> N'sa'
  AND sp.name <> N'NT AUTHORITY\SYSTEM'
  AND sp.name NOT LIKE N'NT SERVICE\%'

  ----------------------------------------------------------
  -- No direct database user mapping
  ----------------------------------------------------------

  AND NOT EXISTS
  (
      SELECT 1
      FROM #MappedLogins AS ml
      WHERE ml.login_sid = sp.sid
  )

  ----------------------------------------------------------
  -- No server role membership
  ----------------------------------------------------------

  AND NOT EXISTS
  (
      SELECT 1
      FROM sys.server_role_members AS srm
      WHERE srm.member_principal_id = sp.principal_id
  )

  ----------------------------------------------------------
  -- No explicit granted server permissions
  ----------------------------------------------------------

  AND NOT EXISTS
  (
      SELECT 1
      FROM sys.server_permissions AS perm
      WHERE perm.grantee_principal_id = sp.principal_id
        AND perm.state IN (N'G', N'W')
  );

------------------------------------------------------------
-- Cleanup
------------------------------------------------------------

DROP TABLE #MappedLogins;

------------------------------------------------------------
-- Return unmapped login count
------------------------------------------------------------

SELECT
    @UnmappedLogins AS unmapped_logins;
