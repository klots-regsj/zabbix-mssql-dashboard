WITH activity AS
(
    SELECT
        s.database_id,
        MAX(v.dt) AS last_access
    FROM sys.dm_db_index_usage_stats AS s
    CROSS APPLY
    (
        VALUES
            (s.last_user_lookup),
            (s.last_user_scan),
            (s.last_user_seek),
            (s.last_user_update)
    ) AS v(dt)
    GROUP BY s.database_id
),
database_info AS
(
    SELECT DISTINCT
        d.database_id,
        d.name,
        d.state_desc,
        d.source_database_id,
        adc.group_id
    FROM sys.databases AS d
    LEFT JOIN sys.availability_databases_cluster AS adc
        ON adc.database_name = d.name
)
SELECT
    COUNT(*) AS inactive_databases
FROM database_info AS d
LEFT JOIN activity AS a
    ON a.database_id = d.database_id
WHERE d.database_id > 4
  AND d.state_desc = N'ONLINE'
  AND d.source_database_id IS NULL
  AND d.name NOT IN (N'DBA')
  AND a.last_access IS NULL

  -- Standalone database
  -- ELLER AG-database hvor denne server er PRIMARY
  AND
  (
      d.group_id IS NULL

      OR EXISTS
      (
          SELECT 1
          FROM sys.dm_hadr_availability_replica_states AS ars
          WHERE ars.group_id = d.group_id
            AND ars.is_local = 1
            AND ars.role_desc = N'PRIMARY'
      )
  );
