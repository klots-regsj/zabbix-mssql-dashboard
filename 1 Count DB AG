DECLARE @IsSecondary BIT = 0;

-- Tjek om den aktuelle server er sekundær i en AG
IF EXISTS (
    SELECT 1
    FROM sys.dm_hadr_availability_replica_states rs
    JOIN sys.availability_groups ag ON rs.group_id = ag.group_id
    WHERE rs.role = 2 -- 2 = SECONDARY
)
BEGIN
    SET @IsSecondary = 1;
END

SELECT
    CASE
        WHEN @IsSecondary = 1 THEN COUNT(*)
        ELSE 0
    END AS DatabaseCount
FROM sys.databases db
WHERE db.database_id > 4
AND db.name NOT LIKE 'DBA%'
AND db.name NOT IN ('master', 'tempdb', 'model', 'msdb')
AND db.state = 0
AND db.is_read_only = 0
AND EXISTS (
    SELECT 1
    FROM sys.dm_hadr_availability_replica_states rs
    JOIN sys.availability_groups ag ON rs.group_id = ag.group_id
    JOIN sys.dm_hadr_database_replica_states drs ON rs.group_id = drs.group_id AND rs.replica_id = drs.replica_id
    JOIN sys.databases agdb ON drs.database_id = agdb.database_id
    WHERE agdb.name = db.name
);
