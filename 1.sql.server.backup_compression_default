
/*
Name          : 1.sql.server.backup_compression_default
Purpose       : Returns whether backup compression is enabled
                by default for the SQL Server instance.
ODBC Key      : db.odbc.select[1.sql.server.backup_compression_default,,"Driver={$MSSQL.ODBC.DRIVER};Server={$MSSQL.HOST};Port={$MSSQL.PORT};UID={$MSSQL.USER};PWD={$MSSQL.PASSWORD};Encrypt={$MSSQL.ENCRYPT}"]
Interval      : 24h
History       : 730d
Trends        : 1825d
Type          : Numeric (unsigned)
Compatibility : SQL Server 2012+
AG Handling   : Instance-level setting; AG role is irrelevant.
Notes         : Returns the active configuration (value_in_use).
                0 = Disabled
                1 = Enabled
                Individual backup commands can override this
                setting using WITH COMPRESSION or NO_COMPRESSION.
                Intended for configuration inventory and
                housekeeping across SQL Server instances.
*/

SET NOCOUNT ON;

SELECT
    CAST(value_in_use AS int) AS backup_compression_default
FROM sys.configurations
WHERE name = N'backup compression default';
