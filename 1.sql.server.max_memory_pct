
/*
Name          : 1.sql.server.max_memory_pct
Purpose       : Returns configured SQL Server maximum memory
                as a percentage of total VM physical memory.
ODBC Key      : db.odbc.select[1.sql.server.max_memory_pct,,"Driver={$MSSQL.ODBC.DRIVER};Server={$MSSQL.HOST};Port={$MSSQL.PORT};UID={$MSSQL.USER};PWD={$MSSQL.PASSWORD};Encrypt={$MSSQL.ENCRYPT}"]
Interval      : 24h
History       : 730d
Trends        : 1825d
Type          : Numeric (float)
Units         : %
Compatibility : SQL Server 2012+
AG Handling   : Instance-level setting; AG role is irrelevant.
Notes         : Uses max server memory (MB) from sys.configurations
                and physical_memory_kb from sys.dm_os_sys_info.
                Returns the configured limit, not actual usage.
                Values above 100% indicate a configured maximum
                greater than the VM's physical RAM.
                SQL Server's default maximum is effectively
                unlimited and may produce very large percentages.
*/

SET NOCOUNT ON;

SELECT
    CAST(
        c.value_in_use * 100.0 /
        NULLIF(s.physical_memory_kb / 1024.0, 0)
        AS decimal(18,2)
    ) AS max_memory_pct
FROM sys.configurations AS c
CROSS JOIN sys.dm_os_sys_info AS s
WHERE c.name = N'max server memory (MB)';
