WITH cte AS (
    SELECT
        database_id,
        dt
    FROM sys.dm_db_index_usage_stats
    UNPIVOT (
        dt FOR op IN (
            last_user_lookup,
            last_user_scan,
            last_user_seek,
            last_user_update
        )
    ) AS b
)
SELECT TOP 1
    DATEDIFF(
        DAY,
        COALESCE(
            MAX(c.dt),
            (SELECT sqlserver_start_time FROM sys.dm_os_sys_info)
        ),
        GETDATE()
    ) AS days_since_last_access
FROM sys.databases AS d
LEFT JOIN cte AS c
    ON d.database_id = c.database_id
WHERE d.database_id > 4
  AND d.state_desc = 'ONLINE'
  AND d.name NOT IN ('DBA')
GROUP BY d.database_id
ORDER BY days_since_last_access DESC;
