/* =========================================================
   Count user databases NOT owned by sa
   - Standalone: numeric count
   - AG Primary: numeric count
   - AG Secondary: 0
   ========================================================= */

DECLARE @IsHadrEnabled bit;
DECLARE @IsSecondary   bit = 0;

/* Is Always On enabled on this instance? */
SELECT @IsHadrEnabled =
       CAST(SERVERPROPERTY('IsHadrEnabled') AS bit);

IF @IsHadrEnabled = 1
BEGIN
    IF EXISTS (
        SELECT 1
        FROM sys.dm_hadr_availability_replica_states
        WHERE is_local = 1
          AND role_desc = 'SECONDARY'
    )
    BEGIN
        SET @IsSecondary = 1;
    END
END

IF @IsSecondary = 1
BEGIN
    -- AG secondary: no signal
    SELECT CAST(0 AS int) AS user_database_count_not_sa;
END
ELSE
BEGIN
    -- Standalone or AG primary
    SELECT COUNT(*) AS user_database_count_not_sa
    FROM sys.databases d
    JOIN sys.server_principals sp
      ON d.owner_sid = sp.sid
    WHERE d.database_id > 4
      AND d.state_desc = 'ONLINE'
      AND sp.name <> 'sa';
END
