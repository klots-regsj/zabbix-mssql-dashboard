/* =========================================================
   Count user databases with compatibility level
   lower than SQL Server major version
   - Standalone: numeric count
   - AG Primary: numeric count
   - AG Secondary: SAME numeric count
   ========================================================= */

DECLARE @ServerCompat int;

/* Map SQL Server major version → compatibility level */
SELECT @ServerCompat =
    CASE CAST(SERVERPROPERTY('ProductMajorVersion') AS int)
        WHEN 16 THEN 160  -- SQL Server 2022
        WHEN 15 THEN 150  -- SQL Server 2019
        WHEN 14 THEN 140  -- SQL Server 2017
        WHEN 13 THEN 130  -- SQL Server 2016
        WHEN 12 THEN 120  -- SQL Server 2014
        WHEN 11 THEN 110  -- SQL Server 2012
        ELSE NULL
    END;

SELECT
    COUNT(*) AS user_database_count_low_compat
FROM sys.databases
WHERE database_id > 4
  AND state_desc = 'ONLINE'
  AND @ServerCompat IS NOT NULL
  AND compatibility_level < @ServerCompat;
