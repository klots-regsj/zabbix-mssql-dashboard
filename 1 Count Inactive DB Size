DECLARE @sqlserver_start_time datetime =
(
    SELECT sqlserver_start_time
    FROM sys.dm_os_sys_info
);
DECLARE @now datetime = GETDATE();

WITH activity AS (
    SELECT
        s.database_id,
        MAX(v.dt) AS last_access
    FROM sys.dm_db_index_usage_stats AS s
    CROSS APPLY (
        VALUES
            (s.last_user_lookup),
            (s.last_user_scan),
            (s.last_user_seek),
            (s.last_user_update)
    ) AS v(dt)
    GROUP BY s.database_id
),
data_files AS (
    SELECT
        database_id,
        SUM(CAST(size AS bigint)) AS total_pages
    FROM sys.master_files
    WHERE type = 0  -- kun datafiler, ingen transaktionslog
    GROUP BY database_id
)
SELECT
    CAST(
        COALESCE(SUM(f.total_pages), 0) * 8.0 / 1024 / 1024
        AS decimal(18, 2)
    ) AS inactive_databases_size_gb
FROM sys.databases AS d
LEFT JOIN activity AS a
    ON a.database_id = d.database_id
LEFT JOIN data_files AS f
    ON f.database_id = d.database_id
WHERE d.database_id > 4
  AND (
      d.group_database_id IS NULL
      OR sys.fn_hadr_is_primary_replica(d.name) = 1
  )
  AND DATEDIFF(
        DAY,
        COALESCE(a.last_access, @sqlserver_start_time),
        @now
      ) = DATEDIFF(DAY, @sqlserver_start_time, @now);
