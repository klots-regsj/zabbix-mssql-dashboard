SET NOCOUNT ON;

CREATE TABLE #Space
(
    SizePages bigint,
    FreePages bigint NULL
);

DECLARE @SQL nvarchar(max);

SELECT @SQL = STRING_AGG(CAST(N'
USE ' + QUOTENAME(name) + N';

INSERT INTO #Space
SELECT
    CAST(size AS bigint),
    CAST(size AS bigint)
      - CAST(FILEPROPERTY(name, ''SpaceUsed'') AS bigint)
FROM sys.database_files
WHERE type = 0
  AND physical_name LIKE N''D:\%'';
' AS nvarchar(max)), NCHAR(10))
FROM master.sys.databases
WHERE database_id > 4
  AND state = 0
  AND source_database_id IS NULL
  AND HAS_DBACCESS(name) = 1;

EXEC sys.sp_executesql @SQL;

SELECT
    CASE
        WHEN COUNT(*) = COUNT(FreePages)
        THEN CAST(
            100.0 * SUM(FreePages) / NULLIF(SUM(SizePages), 0)
            AS decimal(6,2)
        )
    END AS FreePercent
FROM #Space;

DROP TABLE #Space;
