
/*
===============================================================================
ZABBIX SQL SERVER MONITORING - VERSION 1.0
===============================================================================
Name         : 1.sql.server.enterprise_license_assessment
Purpose      : Identify Enterprise Edition instances that may
               be candidates for SQL Server Standard Edition.

ODBC Key     : db.odbc.select[1.sql.server.enterprise_license_assessment,,"Driver={$MSSQL.ODBC.DRIVER};Server={$MSSQL.HOST};Port={$MSSQL.PORT};UID={$MSSQL.USER};PWD={$MSSQL.PASSWORD};Encrypt={$MSSQL.ENCRYPT}"]

Interval     : 24h
History      : 730d
Trends       : Not applicable
Type         : Character
Compatibility: SQL Server 2016+

AG Handling  : Evaluates local Availability Group configuration.

Notes        : ENT->STD = Potential Standard Edition candidate.
               RIGHT    = Known Enterprise-only requirement.
               NOT-ENT  = Not Enterprise Edition.
               REVIEW   = Further DBA assessment required.

               SQL Server 2016 SP1+ supports partitioning
               and data compression in Standard Edition.

               Checks configured memory and AG presence.
               SQL Server 2016 RTM additionally checks
               partitioning and compression.

               This is a technical screening only.
               It does not validate all edition limits,
               features or licensing requirements.
               Returns one character value.
===============================================================================
*/

SET NOCOUNT ON;

DECLARE @Edition nvarchar(128);
DECLARE @MajorVersion int;
DECLARE @ProductLevel nvarchar(128);
DECLARE @RequiresEnterprise bit = 0;
DECLARE @RequiresReview bit = 0;
DECLARE @MaxMemoryMB bigint;
DECLARE @DatabaseName sysname;
DECLARE @SQL nvarchar(max);
DECLARE @HasLegacyFeatures bit = 0;

------------------------------------------------------------
-- 1. Identify edition and version
------------------------------------------------------------

SELECT
    @Edition =
        CAST(SERVERPROPERTY('Edition') AS nvarchar(128)),
    @MajorVersion =
        CAST(SERVERPROPERTY('ProductMajorVersion') AS int),
    @ProductLevel =
        CAST(SERVERPROPERTY('ProductLevel') AS nvarchar(128));

------------------------------------------------------------
-- 2. Check Enterprise Edition
------------------------------------------------------------

IF @Edition NOT LIKE N'%Enterprise%'
BEGIN
    SELECT
        CAST('NOT-ENT' AS varchar(16))
            AS enterprise_license_assessment;
    RETURN;
END;

------------------------------------------------------------
-- 3. Check configured maximum server memory
--
-- Standard Edition memory limit: 128 GB
-- A configured value above this limit requires review.
------------------------------------------------------------

SELECT
    @MaxMemoryMB = CAST(value_in_use AS bigint)
FROM sys.configurations
WHERE name = N'max server memory (MB)';

IF @MaxMemoryMB > 131072
BEGIN
    SET @RequiresReview = 1;
END;

------------------------------------------------------------
-- 4. Check Availability Groups
--
-- Standard Edition supports Basic Availability Groups.
-- Other AG configurations may require Enterprise.
------------------------------------------------------------

IF EXISTS
(
    SELECT 1
    FROM sys.availability_groups
)
BEGIN
    SET @RequiresReview = 1;
END;

------------------------------------------------------------
-- 5. SQL Server 2016 RTM feature check
--
-- Partitioning and compression became available in
-- Standard Edition starting with SQL Server 2016 SP1.
------------------------------------------------------------

IF @MajorVersion = 13
   AND @ProductLevel = N'RTM'
BEGIN

    DECLARE database_cursor CURSOR LOCAL FAST_FORWARD FOR

    SELECT
        d.name
    FROM sys.databases AS d
    WHERE d.database_id > 4
      AND d.state_desc = N'ONLINE'
      AND d.source_database_id IS NULL
      AND d.name NOT LIKE N'DBA%'
      AND
      (
          d.replica_id IS NULL
          OR EXISTS
          (
              SELECT 1
              FROM sys.dm_hadr_database_replica_states AS drs
              INNER JOIN sys.dm_hadr_availability_replica_states AS ars
                  ON ars.group_id = drs.group_id
                 AND ars.replica_id = drs.replica_id
              WHERE drs.database_id = d.database_id
                AND drs.is_local = 1
                AND ars.is_local = 1
                AND ars.role = 1
          )
      );

    OPEN database_cursor;

    FETCH NEXT FROM database_cursor INTO @DatabaseName;

    WHILE @@FETCH_STATUS = 0
    BEGIN

        SET @SQL = N'
            USE ' + QUOTENAME(@DatabaseName) + N';

            IF EXISTS
            (
                SELECT 1
                FROM sys.partitions
                WHERE partition_number > 1
                   OR data_compression > 0
            )
            BEGIN
                SET @Found = 1;
            END;
        ';

        BEGIN TRY

            EXEC sys.sp_executesql
                @SQL,
                N'@Found bit OUTPUT',
                @Found = @HasLegacyFeatures OUTPUT;

        END TRY
        BEGIN CATCH

            SET @RequiresReview = 1;

        END CATCH;

        FETCH NEXT FROM database_cursor INTO @DatabaseName;

    END;

    CLOSE database_cursor;
    DEALLOCATE database_cursor;

    IF @HasLegacyFeatures = 1
        SET @RequiresEnterprise = 1;

END;

------------------------------------------------------------
-- 6. Return assessment
------------------------------------------------------------

SELECT
    CAST
    (
        CASE
            WHEN @RequiresEnterprise = 1
                THEN 'RIGHT'

            WHEN @RequiresReview = 1
                THEN 'REVIEW'

            ELSE 'ENT->STD'
        END
        AS varchar(16)
    ) AS enterprise_license_assessment;
