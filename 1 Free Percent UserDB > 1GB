SET NOCOUNT ON;

CREATE TABLE #Result
(
    DatabaseName sysname,
    FreePercent decimal(6,2)
);

DECLARE @SQL nvarchar(max);

SELECT @SQL = STRING_AGG(CAST(N'
USE ' + QUOTENAME(name) + N';

INSERT INTO #Result
SELECT
    DB_NAME(),
    CASE WHEN COUNT(*) = COUNT(FILEPROPERTY(name, ''SpaceUsed''))
         THEN 100.0 * (
             SUM(CAST(size AS bigint))
             - SUM(CAST(FILEPROPERTY(name, ''SpaceUsed'') AS bigint))
         ) / NULLIF(SUM(CAST(size AS bigint)), 0)
    END
FROM sys.database_files
WHERE type = 0
  AND physical_name LIKE N''D:\%''
HAVING SUM(CAST(size AS bigint)) > 131072;
' AS nvarchar(max)), NCHAR(10))
FROM master.sys.databases
WHERE database_id > 4
  AND state = 0
  AND source_database_id IS NULL
  AND HAS_DBACCESS(name) = 1;

EXEC sys.sp_executesql @SQL;

SELECT DatabaseName, FreePercent
FROM #Result
ORDER BY DatabaseName;

DROP TABLE #Result;
