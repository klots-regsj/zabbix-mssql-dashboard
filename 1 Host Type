/* =========================================================
   Host role status
   Returns:
     AG_P  = Availability Group Primary
     AG_S  = Availability Group Secondary
     SQL   = Standalone (no AG)
   ========================================================= */

DECLARE @IsHadrEnabled bit;
DECLARE @Role varchar(5);

/* Is Always On enabled on this instance? */
SELECT @IsHadrEnabled =
       CAST(SERVERPROPERTY('IsHadrEnabled') AS bit);

IF @IsHadrEnabled = 1
BEGIN
    IF EXISTS (
        SELECT 1
        FROM sys.dm_hadr_availability_replica_states
        WHERE is_local = 1
          AND role_desc = 'PRIMARY'
    )
        SET @Role = 'AG_P';
    ELSE
        SET @Role = 'AG_S';
END
ELSE
BEGIN
    SET @Role = 'SQL';
END

SELECT @Role AS host_status;
